module Main =>

enum struct Bool { True, False }

fun and(a: Bool, b: Bool) =>
    if a => if b => Bool::True
            else => Bool::False
    else => Bool::False

fun not(self: Bool) =>
    if self => Bool::False
    else => Bool::True

fun rule110(a: Bool, b: Bool, c: Bool) =>
    if   and(a,      and(b,      c))      => Bool::False
    elif and(a,      and(b,      not(c))) => Bool::True
    elif and(a,      and(not(b), c))      => Bool::True
    elif and(a,      and(not(b), not(c))) => Bool::False
    elif and(not(a), and(b,      c))      => Bool::True
    elif and(not(a), and(b,      not(c))) => Bool::True
    elif and(not(a), and(not(b), c))      => Bool::True
    else                                  => Bool::False

fun main => rule110(Bool::True, Bool::True, Bool::True)
