        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    Tokens      -> .
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    Tokens      -> . TokenMatch+
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    __Tokens    -> . Tokens
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    r#"\\s"#+   -> . r#"\\s"#+ r#"\\s"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    r#"\\s"#+   -> . r#"\\s"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof


    reduction Tokens ->
        lookahead Eof

    "\t"                                                  shift and goto 18
    "\n"                                                  shift and goto 19
    "\r"                                                  shift and goto 20
    "\r\n"                                                shift and goto 21
    " "                                                   shift and goto 22
    "!"                                                   shift and goto 23
    "!="                                                  shift and goto 24
    "%"                                                   shift and goto 25
    "&"                                                   shift and goto 26
    "&&"                                                  shift and goto 27
    "("                                                   shift and goto 28
    ")"                                                   shift and goto 29
    "*"                                                   shift and goto 30
    "**"                                                  shift and goto 31
    "+"                                                   shift and goto 32
    ","                                                   shift and goto 33
    "-"                                                   shift and goto 34
    "."                                                   shift and goto 35
    "/"                                                   shift and goto 36
    ":"                                                   shift and goto 37
    "::"                                                  shift and goto 38
    ";"                                                   shift and goto 39
    "<"                                                   shift and goto 40
    "<="                                                  shift and goto 41
    "<=>"                                                 shift and goto 42
    "="                                                   shift and goto 43
    "=="                                                  shift and goto 44
    "=>"                                                  shift and goto 45
    ">"                                                   shift and goto 46
    ">="                                                  shift and goto 47
    "["                                                   shift and goto 48
    "\\"                                                  shift and goto 49
    "]"                                                   shift and goto 50
    "^"                                                   shift and goto 51
    "_"                                                   shift and goto 52
    "abstract"                                            shift and goto 53
    "class"                                               shift and goto 54
    "elif"                                                shift and goto 55
    "else"                                                shift and goto 56
    "enum"                                                shift and goto 57
    "extend"                                              shift and goto 58
    "foreign"                                             shift and goto 59
    "fun"                                                 shift and goto 60
    "if"                                                  shift and goto 61
    "match"                                               shift and goto 62
    "module"                                              shift and goto 63
    "return"                                              shift and goto 64
    "struct"                                              shift and goto 65
    "trait"                                               shift and goto 66
    "type"                                                shift and goto 67
    "val"                                                 shift and goto 68
    "var"                                                 shift and goto 69
    "while"                                               shift and goto 70
    "with"                                                shift and goto 71
    "{"                                                   shift and goto 72
    "|"                                                   shift and goto 73
    "||"                                                  shift and goto 74
    "}"                                                   shift and goto 75
    "~"                                                   shift and goto 76
    r#"\"([^\"]|\\\\\")*\""#                              shift and goto 77
    r#"'([^']|\\\\')'"#                                   shift and goto 78
    r#"0[bB](([^0_][01_]+)|[01])"#                        shift and goto 79
    r#"0[cC](([^0_][0-7]+)|[0-7])"#                       shift and goto 80
    r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"#          shift and goto 81
    r#"[+-]"#                                             shift and goto 82
    r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# shift and goto 83
    r#"\\s"#                                              shift and goto 84
    r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"#                       shift and goto 85
    r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"#                       shift and goto 86

    BinLit                                                goto 5
    FloatingLit                                           goto 6
    HexLit                                                goto 7
    Identifier                                            goto 8
    Ignore                                                goto 9
    Keyword                                               goto 10
    Literal                                               goto 11
    OctLit                                                goto 12
    Operator                                              goto 13
    Sign                                                  goto 1
    Symbol                                                goto 14
    TokenMatch                                            goto 15
    TokenMatch+                                           goto 2
    Token_                                                goto 16
    Tokens                                                goto 17
    r#"\\s"#+                                             goto 3
}

State 1 {

    FloatingLit -> . r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    Literal     -> Sign . FloatingLit
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    Literal     -> Sign . r#"\\s"#+ FloatingLit
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    r#"\\s"#+   -> . r#"\\s"#+ r#"\\s"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    r#"\\s"#+   -> . r#"\\s"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# shift and goto 83
    r#"\\s"#                                              shift and goto 84

    FloatingLit                                           goto 87
    r#"\\s"#+                                             goto 4
}

State 2 {

    BinLit      -> . r#"0[bB](([^0_][01_]+)|[01])"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    FloatingLit -> . r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    HexLit      -> . r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    Identifier  -> . r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

    Identifier  -> . r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"#
        lookahead r#"\"([^\"]|\\\\\")*\""# r#"'([^']|\\\\')'"# r#"0[bB](([^0_][01_]+)|[01])"# r#"0[cC](([^0_][0-7]+)|[0-7])"# r#"0[xX](([^0_][0-9a-fA-F_]+)|[0-9a-fA-F])"# r#"[+-]"# r#"[0-9]+((\\.[0-9]*)?|(\\.[0-9])+)([eE][+-]?[0-9]+)?"# r#"\\s"# r#"_*\\p{Ll}[\\p{Alpha}\\d_]*"# r#"_*\\p{Lu}[\\p{Alpha}\\d_]*"# "\t" "\n" "\r" "\r\n" " " "!" "!=" "%" "&" "&&" "(" ")" "*" "**" "+" "," "-" "." "/" ":" "::" ";" "<" "<=" "<=>" "=" "==" "=>" ">" ">=" "[" "\\" "]" "^" "_" "abstract" "class" "elif" "else" "enum" "extend" "foreign" "fun" "if" "match" "module" "return" "struct" "trait" "type" "val" "var" "while" "with" "{" "|" "||" "}" "~" Eof

